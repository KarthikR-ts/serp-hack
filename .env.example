SERPAPI_API_KEY=your_key_here
# LLM router (OpenRouter, OpenAI-compatible). Required for the Agent (LLM) flow.
OPENROUTER_API_KEY=your_key_here
# Model selection for OpenRouter. Change to any model ID from openrouter.ai/models.
# Examples: openai/gpt-4o-mini, openai/gpt-4o, google/gemini-2.0-flash-001,
# anthropic/claude-3-5-haiku, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat
LLM_MODEL=openai/gpt-4o-mini
# Reasoning traces use a SEPARATE small model (one-liners only, never blocks).
# Any failure falls back to deterministic templates — safe to leave unset.
# REASONING_MODEL=openai/gpt-4o-mini
# REASONING_API_KEY=your_key_here  # fallback: OPENROUTER_API_KEY, then LLM_API_KEY
# REASONING_BASE_URL=https://openrouter.ai/api/v1  # fallback: OPENROUTER_BASE_URL
# Routing Backend: 'laya' (default System 1 decision engine), 'llm', or 'hybrid'
ROUTER_BACKEND=laya
# Optional defaults
# SERPAPI_LOCATION="Bengaluru, India"

