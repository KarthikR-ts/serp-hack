SERPAPI_API_KEY=your_key_here
# LLM router (OpenRouter, OpenAI-compatible). Required for the Agent (LLM) flow.
OPENROUTER_API_KEY=your_key_here
# Model selection for OpenRouter. Change to any model ID from openrouter.ai/models.
# Examples: openai/gpt-4o-mini, openai/gpt-4o, google/gemini-2.0-flash-001,
# anthropic/claude-3-5-haiku, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat
LLM_MODEL=openai/gpt-4o-mini
# Optional defaults
# SERPAPI_LOCATION="Bengaluru, India"
